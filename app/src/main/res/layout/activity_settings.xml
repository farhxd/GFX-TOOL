<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".settings"
    android:background="@color/black"
    android:orientation="vertical">

    <ScrollView
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/textView"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:text="Optimizer GFX" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version: 1.0"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <LinearLayout
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bgoption"
                android:backgroundTint="#20FFFFFF"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" >

                <Switch
                    android:textSize="18sp"
                    android:id="@+id/switch1"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Extra Optimizations" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:text="Applies Graphic Extensions with the Config files. Enable this this for extra increase in FPS."
                    android:textColor="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#90FFFFFF">

                </LinearLayout>

                <Switch
                    android:id="@+id/autoSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="4dp"
                    android:text="Auto Apply (Shizuku)"
                    android:textColor="@color/white"
                    android:textSize="18sp"></Switch>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:text="Quickly applies the resolution files and clears data automatically. \nOnly Available in Shizuku Mode"
                    android:textColor="@color/white">

                </TextView>

            </LinearLayout>

        <LinearLayout
            android:paddingHorizontal="0dp"
            android:paddingVertical="4dp"

            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <LinearLayout
                android:background="@drawable/bgoption"
                android:backgroundTint="#20FFFFFF"
                android:id="@+id/tutor"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="8dp"
                    android:background="#00FFFFFF"
                    android:src="@drawable/baseline_help_24"
                    app:srcCompat="@drawable/baseline_help_24"
                    tools:srcCompat="@drawable/baseline_help_24">

                </ImageView>

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How to use this GFX"
                android:textSize="18sp"
                android:textColor="@color/white">

            </TextView>
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/bgoption"
                android:backgroundTint="#20FFFFFF"
                android:id="@+id/ytube"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/youtube_1024"
                    app:srcCompat="@drawable/youtube_1024"
                    tools:srcCompat="@drawable/youtube_1024">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subcribe to Youtube Channel"
                    android:textSize="18sp"
                    android:textColor="@color/white">

                </TextView>
            </LinearLayout>
            <LinearLayout
                android:background="@drawable/bgoption"
                android:backgroundTint="#20FFFFFF"
                android:id="@+id/tgram"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/telegram_logo"
                    app:srcCompat="@drawable/telegram_logo"
                    tools:srcCompat="@drawable/telegram_logo">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join Telegram Channel"
                    android:textSize="18sp"
                    android:textColor="@color/white">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/xdtool"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bgoption"
                android:backgroundTint="#20FFFFFF"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="8dp"
                    android:background="#00FFFFFF"
                    android:src="@drawable/xdtool_icon"
                    app:srcCompat="@drawable/xdtool_icon"
                    tools:srcCompat="@drawable/xdtool_icon">

                </ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XD Config Tool"
                    android:textColor="@color/white"
                    android:textSize="18sp">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:background="@drawable/bgoption"
                android:backgroundTint="#20FFFFFF"
                android:id="@+id/moreapp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/ic_launcher_foreground"
                    app:srcCompat="@drawable/ic_launcher_foreground"
                    tools:srcCompat="@drawable/ic_launcher_foreground">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More Apps"
                    android:textSize="18sp"
                    android:textColor="@color/white">

                </TextView>
            </LinearLayout>

        </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/back"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#902196F3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="Back to GFX Home"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="25sp">

    </Button>
</LinearLayout>